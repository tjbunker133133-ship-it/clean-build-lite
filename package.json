{
  "name": "hud-v1",
  "private": true,
  "version": "1.0.0",
  "packageManager": "npm@10.9.7",
  "type": "module",
  "scripts": {
    "ensure:index": "node scripts/ensure-index.mjs",
    "predev": "npm run ensure:index",
    "prebuild": "npm run ensure:index",
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "verify:tier1": "node scripts/verify-tier1-contract.mjs && node scripts/verify-tier1-freeze.mjs && vitest run src/lib/tier1Contract.test.ts src/lib/tier1Freeze.test.ts",
    "verify": "tsc --noEmit && vitest run && node scripts/verify-tier1-contract.mjs && vite build",
    "env:init": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/init-env.ps1",
    "env:setup": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/set-env-interactive.ps1",
    "env:open": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/open-env.ps1",
    "env:check": "node scripts/check-env.mjs",
    "env:sync-vercel": "node scripts/sync-vercel-env.mjs",
    "env:check-signing": "node scripts/check-signing-key-digest.mjs",
    "env:sync-signing": "node scripts/sync-rescue-signing-key.mjs",
    "env:verify-signing": "node scripts/verify-rescue-signing.mjs",
    "env:verify-contract": "node scripts/verify-rescue-contract.mjs",
    "smoke": "npm run verify"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.105.3",
    "maplibre-gl": "^5.0.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "resend": "^6.12.3",
    "vite-plugin-pwa": "^1.2.0"
  },
  "devDependencies": {
    "@types/react": "^18.2.43",
    "@types/react-dom": "^18.2.17",
    "@typescript-eslint/eslint-plugin": "^8.59.1",
    "@typescript-eslint/parser": "^8.59.1",
    "@vitejs/plugin-react": "^4.2.1",
    "eslint": "^10.3.0",
    "playwright": "^1.59.1",
    "prettier": "^3.8.3",
    "typescript": "^5.2.2",
    "vite": "^5.0.0",
    "vitest": "^3.0.0"
  }
}
