{
  "name": "hud-v1",
  "private": true,
  "version": "1.0.0",
  "packageManager": "npm@10.9.7",
  "type": "module",
  "scripts": {
    "ensure:index": "node scripts/ensure-index.mjs",
    "predev": "npm run ensure:index",
    "prebuild": "npm run ensure:index && npm run build:plugins",
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "preview:hud": "node scripts/preview-hud.mjs",
    "preview:teardown": "node scripts/teardown-preview.mjs",
    "preview:clean": "node scripts/teardown-preview.mjs && node scripts/preview-hud.mjs",
    "e2e": "playwright test",
    "e2e:phase7": "playwright test e2e/phase7-production-validation.spec.ts --project=chromium",
    "e2e:phase8": "playwright test e2e/phase8-production-stabilization.spec.ts --project=chromium",
    "e2e:phase9": "playwright test e2e/phase9-field-validation.spec.ts --project=chromium",
    "e2e:identity": "playwright test e2e/modern-identity-separation.spec.ts --project=chromium",
    "e2e:layer-contract": "playwright test e2e/layer-contract-runtime.spec.ts --project=chromium",
    "e2e:camera": "playwright test e2e/camera-authority.spec.ts --project=chromium",
    "e2e:runtime-truth": "playwright test e2e/runtime-truth.spec.ts --project=chromium",
    "e2e:presentation-isolation": "playwright test e2e/presentation-isolation.spec.ts --project=chromium",
    "e2e:composition": "playwright test e2e/mode-composition-identity.spec.ts --project=chromium",
    "test": "vitest run",
    "verify:tier1": "node scripts/verify-tier1-contract.mjs && node scripts/verify-tier1-freeze.mjs && vitest run src/lib/tier1Contract.test.ts src/lib/tier1Freeze.test.ts",
    "verify": "tsc --noEmit && vitest run && node scripts/verify-tier1-contract.mjs && vite build",
    "verify:runtime": "npm run verify && node scripts/runtime-audit.mjs",
    "build:plugin": "npm run build --prefix plugins/capacitor-hud-mission-link",
    "build:plugins": "npm run build:plugin && npm run build --prefix plugins/capacitor-hud-health-connect",
    "cap:sync": "npm run build && npm run build:plugins && npx cap sync android",
    "cap:open:android": "npx cap open android",
    "env:init": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/init-env.ps1",
    "env:setup": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/set-env-interactive.ps1",
    "env:open": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/open-env.ps1",
    "env:check": "node scripts/check-env.mjs",
    "env:sync-vercel": "node scripts/sync-vercel-env.mjs",
    "env:check-signing": "node scripts/check-signing-key-digest.mjs",
    "env:sync-signing": "node scripts/sync-rescue-signing-key.mjs",
    "env:sync-gmail": "node scripts/sync-gmail-sender.mjs",
    "env:verify-signing": "node scripts/verify-rescue-signing.mjs",
    "env:verify-contract": "node scripts/verify-rescue-contract.mjs",
    "env:set-firms": "node scripts/set-firms-key.mjs",
    "env:set-maptiler": "node scripts/set-maptiler-key.mjs",
    "env:generate-vapid": "node scripts/generate-vapid-keys.mjs",
    "env:sync-vapid": "node scripts/run-sync-vapid.mjs",
    "deploy:push": "node scripts/deploy-alert-push.mjs",
    "verify:register-push": "node scripts/verify-register-alert-push.mjs",
    "smoke": "npm run verify"
  },
  "overrides": {
    "esbuild": "^0.25.0",
    "tar": "^7.5.15"
  },
  "dependencies": {
    "@capacitor/share": "^6.0.4",
    "@signal-one/capacitor-hud-health-connect": "file:plugins/capacitor-hud-health-connect",
    "@signal-one/capacitor-hud-mission-link": "file:plugins/capacitor-hud-mission-link",
    "@supabase/supabase-js": "^2.105.3",
    "maplibre-gl": "^5.0.0",
    "qrcode": "^1.5.4",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "resend": "^6.12.3",
    "vite-plugin-pwa": "^1.2.0"
  },
  "devDependencies": {
    "@capacitor/android": "^6.2.0",
    "@capacitor/cli": "^6.2.0",
    "@capacitor/core": "^6.2.0",
    "@playwright/test": "^1.60.0",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^18.2.43",
    "@types/react-dom": "^18.2.17",
    "@typescript-eslint/eslint-plugin": "^8.59.1",
    "@typescript-eslint/parser": "^8.59.1",
    "@vitejs/plugin-react": "^4.3.4",
    "eslint": "^10.3.0",
    "playwright": "^1.59.1",
    "prettier": "^3.8.3",
    "typescript": "^5.2.2",
    "vite": "^6.4.2",
    "vitest": "^3.0.0",
    "web-push": "^3.6.7"
  }
}
