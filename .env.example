# Copy to .env.local at the PROJECT ROOT (not inside env/).
# Or run: npm run env:init
# Full guide: env/SETUP.md

# REQUIRED — Supabase
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
VITE_RESCUE_SIGNING_KEY=
VITE_RESCUE_EMAIL_URL=https://YOUR_REF.supabase.co/functions/v1/send-rescue-email

# OPTIONAL — remote mission monitor (WebRTC TURN for coast-to-coast)
# VITE_MISSION_TURN_URL=
# VITE_MISSION_TURN_USERNAME=
# VITE_MISSION_TURN_CREDENTIAL=

# OPTIONAL — rescue email sender (Supabase secrets only; run npm run env:sync-gmail)
# Do NOT commit real app passwords. Production sender: signalonehud@gmail.com
# GMAIL_USER=signalonehud@gmail.com
# GMAIL_APP_PASSWORD=

VITE_MAPTILER_KEY=
# VITE_GOOGLE_MAPS_API_KEY=
# VITE_MAPBOX_ACCESS_TOKEN=
